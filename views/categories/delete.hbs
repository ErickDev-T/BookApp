<main class="container py-4">
    <h1 class="mb-3">Eliminar Categoria</h1>
    <p class="mb-4">esta seguro que desea eliminar esta categoria? <strong>{{category.name}}</strong></p>

    <form method="post" action="/categories/delete/{{category.id}}" class="d-flex gap-2">
      <a href="/categories" class="btn btn-outline-secondary">Cancelar</a>
      <button type="submit" class="btn btn-danger">Aceptar</button>
    </form>
  </main>

