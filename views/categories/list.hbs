<main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="mb-0">Mantenimiento de Categorias</h1>
      <a href="/categories/create" class="btn btn-primary">Crear Categoria</a>
    </div>

    {{#if successMessage}}
      <div class="alert alert-success">{{successMessage}}</div>
    {{/if}}

    {{#if errorMessage}}
      <div class="alert alert-danger">{{errorMessage}}</div>
    {{/if}}

    {{#if categories.length}}
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead class="table-dark">
            <tr>
              <th>Nombre</th>
              <th>Descripcion</th>
              <th>Cantidad de libros</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {{#each categories}}
              <tr>
                <td>{{this.name}}</td>
                <td>{{this.description}}</td>
                <td>{{this.booksCount}}</td>
                <td class="d-flex gap-2">
                  <a href="/categories/edit/{{this.id}}" class="btn btn-sm btn-outline-secondary">Editar</a>
                  <a href="/categories/delete/{{this.id}}" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="alert alert-info">aun no hay categorias registradas.</div>
    {{/if}}
  </main>

