<main class="container py-4">
    <h1 class="mb-3">Crear Editorial</h1>

    {{#if errorMessage}}
      <div class="alert alert-danger">{{errorMessage}}</div>
    {{/if}}

    <form method="post" action="/publishers/create" class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <label for="name" class="form-label">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-control"
            value="{{formData.name}}"
            required
          >
        </div>

        <div class="mb-3">
          <label for="phone" class="form-label">Telefono</label>
          <input
            type="text"
            id="phone"
            name="phone"
            class="form-control"
            value="{{formData.phone}}"
            required
          >
        </div>

        <div class="mb-3">
          <label for="country" class="form-label">Pais</label>
          <input
            type="text"
            id="country"
            name="country"
            class="form-control"
            value="{{formData.country}}"
            required
          >
        </div>
      </div>

      <div class="card-footer d-flex gap-2">
        <a href="/publishers" class="btn btn-outline-secondary">Volver atras</a>
        <button type="submit" class="btn btn-primary">Crear editorial</button>
      </div>
    </form>
  </main>

