<main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="mb-0">Mantenimiento de Editoriales</h1>
      <a href="/publishers/create" class="btn btn-primary">Crear Editorial</a>
    </div>

    {{#if successMessage}}
      <div class="alert alert-success">{{successMessage}}</div>
    {{/if}}

    {{#if errorMessage}}
      <div class="alert alert-danger">{{errorMessage}}</div>
    {{/if}}

    {{#if publishers.length}}
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead class="table-dark">
            <tr>
              <th>Nombre</th>
              <th>Telefono</th>
              <th>Pais</th>
              <th>Cantidad de libros</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {{#each publishers}}
              <tr>
                <td>{{this.name}}</td>
                <td>{{this.phone}}</td>
                <td>{{this.country}}</td>
                <td>{{this.booksCount}}</td>
                <td class="d-flex gap-2">
                  <a href="/publishers/edit/{{this.id}}" class="btn btn-sm btn-outline-secondary">Editar</a>
                  <a href="/publishers/delete/{{this.id}}" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="alert alert-info">aun no hay editoriales registradas.</div>
    {{/if}}
  </main>

