<main class="container py-4">
    <h1 class="mb-3">Crear Autor</h1>

    {{#if errorMessage}}
      <div class="alert alert-danger">{{errorMessage}}</div>
    {{/if}}

    <form method="post" action="/authors/create" class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <label for="name" class="form-label">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-control"
            value="{{formData.name}}"
            required
          >
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Correo</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            value="{{formData.email}}"
            required
          >
        </div>
      </div>

      <div class="card-footer d-flex gap-2">
        <a href="/authors" class="btn btn-outline-secondary">Volver atras</a>
        <button type="submit" class="btn btn-primary">Crear autor</button>
      </div>
    </form>
  </main>

